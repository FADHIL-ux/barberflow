{
  "name": "barberflow",
  "private": true,
  "version": "0.2.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "scripts\\start-local.bat",
    "dev:api": "npm run dev -w @barberflow/api",
    "dev:web": "npm run dev -w @barberflow/web",
    "test": "npm run test:unit && npm run test -w @barberflow/api",
    "test:unit": "node --test \"packages/shared/src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck -w @barberflow/shared && npm run typecheck -w @barberflow/api && npm run typecheck -w @barberflow/web",
    "build:web": "npm run build -w @barberflow/web",
    "build:api": "npm run build -w @barberflow/api",
    "start:api": "node apps/api/dist/index.js"
  },
  "devDependencies": {
    "pg": "^8.13.0"
  },
  "dependencies": {
    "railway": "^3.17.0"
  }
}
