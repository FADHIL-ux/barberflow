{
  "name": "@barberflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --noExternal @barberflow/shared",
    "start": "node dist/index.js",
    "seed": "tsx --env-file=../../.env src/seed.ts",
    "test": "node --import tsx --env-file=../../.env --test \"src/tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@barberflow/shared": "*",
    "@hono/node-server": "^1.13.0",
    "argon2": "^0.41.1",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}