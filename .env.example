# Salin menjadi .env lalu ganti seluruh nilai CHANGE_ME
POSTGRES_DB=barberflow
POSTGRES_OWNER_USER=barberflow_owner
POSTGRES_OWNER_PASSWORD=CHANGE_ME_OWNER
APP_DB_PASSWORD=CHANGE_ME_APP
PLATFORM_DB_PASSWORD=CHANGE_ME_PLATFORM

DATABASE_URL_OWNER=postgres://barberflow_owner:CHANGE_ME_OWNER@localhost:5432/barberflow
DATABASE_URL_APP=postgres://barberflow_app:CHANGE_ME_APP@localhost:5432/barberflow
DATABASE_URL_PLATFORM=postgres://barberflow_platform:CHANGE_ME_PLATFORM@localhost:5432/barberflow

JWT_SECRET=CHANGE_ME_MIN_32_CHARS
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
